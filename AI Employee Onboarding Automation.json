    {
      "parameters": {
        "jsCode": "const fields=$input.first().json.body.data.fields;\nconst field=fields.find(f=>f.label===\"Full Name:\");\nconst name=field.value;\nconst field_2=fields.find(f=>f.label===\"Email:\");\nconst email=field_2.value;\nconst field_3=fields.find(f=>f.label===\"Phone:\");\nconst phone= field_3.value;\nconst field_4=fields.find(f=>f.label===\"Experience:\");\nconst experience=field_4.value;\nconst field_5=fields.find(f=>f.label===\"Position:\");\nconst position=field_5.value;\nconst field_6=fields.find(f=>f.label===\"Joining date:\");\nconst joining_date = field_6.value;\nconst field_7=fields.find(f=>f.label===\"Manager:\");\nconst manager=field_7.value;\nconst field_8=fields.find(f=>f.label===\"Department:\");\nconst value=field_8.value[0];\nconst options=field_8.options.find(o=>o.id===value);\nconst department=options.text;\nconst field_9=fields.find(f=>f.label===\"Job Title:\");\nconst job_title=field_9.value;\nconst field_10=fields.find(f=>f.label===\"Employment Type:\");\nconst value_1=field_10.value[0];\nconst options_1=field_10.options.find(o=>o.id===value_1);\nconst employement_type=options_1.text;\nconst field_11=fields.find(f=>f.label===\"Equipment Required:\");\nconst value_2=field_11.value[0];\nconst options_2=field_11.options.find(o=>o.id===value_2);\nconst equipments_required=options_2.text;\nreturn[{\n  name,\n  email,\n  phone,\n  experience,\n  position,\n  joining_date,\n  manager,\n  department,\n  job_title,\n  employement_type,\n  equipments_required\n  \n}];"
      },
